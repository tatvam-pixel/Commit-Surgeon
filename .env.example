# Commit Surgeon Environment Configuration
# Copy this file to .env to override defaults

# Application Information
APP_NAME="Commit Surgeon"
APP_VERSION="0.1.0"
DEBUG=false

# Ollama API Configuration (Offline Local LLM Inference)
OLLAMA_API_URL="http://localhost:11434"
DEFAULT_MODEL="qwen3.5:4b"
MODEL_TIMEOUT=60

# Processing Configuration
# Maximum diff size in characters to process in a single batch
MAX_DIFF_SIZE=100000
